# Copy to .env (docker compose reads it automatically)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/regintel
EMBEDDING_BACKEND=hashing            # hashing | sentence-transformers | openai
# EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# OPENAI_API_KEY=
ANSWERER=auto                        # auto | stub | partd
ANALYSIS_LLM=auto                    # Part D: auto | openai | none (extractive)
# ANALYSIS_MODEL=gpt-4o-mini
ANALYSIS_TIMEOUT_S=20                # Part D's LLM budget; keep below ANSWER_TIMEOUT_S
SEED_DIR=eval/seed_corpus            # indexed on first start if the index is empty
TOP_K=5
CACHE_TTL_S=600
ANSWER_TIMEOUT_S=30
ADMIN_TOKEN=change-me                # required for POST /api/admin/reindex
LOG_LEVEL=INFO
LOG_JSON=true
